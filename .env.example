# Copy to .env for local configuration. Never commit .env or place secrets in the renderer.
JARVIS_ENV=development

# LLM provider: mock, openai_compatible, azure_openai
JARVIS_LLM_PROVIDER=mock
JARVIS_LLM_BASE_URL=
JARVIS_LLM_MODEL=
JARVIS_LLM_API_KEY=
JARVIS_AZURE_OPENAI_ENDPOINT=
JARVIS_AZURE_OPENAI_DEPLOYMENT=
JARVIS_AZURE_OPENAI_API_VERSION=
JARVIS_AZURE_OPENAI_API_KEY=
JARVIS_AZURE_SPEECH_REGION=
JARVIS_AZURE_SPEECH_KEY=

# Speech provider selections. Voice providers remain opt-in and backend-owned.
# STT options: mock (test-only/unconfigured), faster_whisper (local), azure (remote).
JARVIS_STT_PROVIDER=mock
# Select an existing model directory; model files are never downloaded automatically.
JARVIS_STT_MODEL_PATH=
JARVIS_STT_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
# Azure Speech sends active utterances remotely only when explicitly configured.
JARVIS_TTS_PROVIDER=mock
# Wake options: push_to_talk or openwakeword with an existing local model file.
JARVIS_WAKE_PROVIDER=push_to_talk
JARVIS_WAKE_MODEL_PATH=
JARVIS_WAKE_PHRASE=Jarvis
JARVIS_WAKE_THRESHOLD=0.65
JARVIS_WEB_SEARCH_PROVIDER=mock
JARVIS_WEB_SEARCH_API_KEY=
JARVIS_WEATHER_PROVIDER=open_meteo
JARVIS_SPEECH_LANGUAGE=en-IN

# Local data policy. Audio is transient and is not retained by the voice API.
JARVIS_DATABASE_URL=
JARVIS_AUDIO_RETENTION=disabled
JARVIS_LOG_LEVEL=INFO
